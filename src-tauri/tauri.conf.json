{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tandem",
  "version": "0.2.0",
  "identifier": "dev.tandem.app",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist/web"
  },
  "app": {
    "windows": [
      {
        "title": "Tandem",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "category": "Productivity",
    "shortDescription": "Write and revise with your local AI tools.",
    "fileAssociations": [
      {
        "ext": ["md"],
        "mimeType": "text/markdown",
        "name": "Markdown document",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "resources": [
      "resources/helper.mjs",
      "resources/node/**/*",
      "resources/node_modules/**/*",
      "resources/package.json",
      "resources/bun.lock"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFERkZDM0UxRUMyRUVDNDcKUldSSDdDN3M0Y1AvSFV0Tm1Sc1FiZTU0dUgvWWdRRjBWcjMzMktHQmlwLzZhS201RkxhTlVwcmwK",
      "endpoints": [
        "https://github.com/blas0/tandem-markdown-editor/releases/latest/download/latest.json"
      ]
    }
  }
}
