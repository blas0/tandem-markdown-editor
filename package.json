{
  "name": "tandem",
  "version": "0.1.4",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:web": "vite --host 127.0.0.1",
    "dev:desktop": "tauri dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "lint": "biome check . && bun run scripts/check-ui-ownership.ts && bun run scripts/check-added-lines.ts",
    "build": "bun run scripts/build.ts",
    "build:desktop": "bun run build && tauri build",
    "tauri": "tauri",
    "validate": "bun run scripts/validate.ts",
    "validate:quick": "bun run scripts/validate.ts --quick"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.251",
    "@base-ui/react": "^1.7.0",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/common": "^1.5.2",
    "@lisse/react": "^0.7.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tiptap/core": "^3",
    "@tiptap/extension-code": "^3",
    "@tiptap/extension-image": "^3",
    "@tiptap/extension-table": "^3",
    "@tiptap/extension-task-item": "^3",
    "@tiptap/extension-task-list": "^3",
    "@tiptap/extension-text-style": "^3",
    "@tiptap/markdown": "^3",
    "@tiptap/pm": "^3",
    "@tiptap/starter-kit": "^3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "diff-match-patch": "^1.0.5",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.22.1",
    "htmlparser2": "^12.0.0",
    "marked": "^18.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@tiptap/html": "^3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.4.0",
    "@types/diff-match-patch": "^1.0.36",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "agentation": "^3.0.2",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "remark": "^15.0.1",
    "remark-lint": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-preset-lint-recommended": "^7.0.1",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
